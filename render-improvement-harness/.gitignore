# Source decks and raw renders are derived or third-party; only reports, summaries and issue evidence are tracked.
decks/*/source.pptx
decks/*/lo-img/
decks/*/bo-img/
decks/*/diff-img/
decks/*/xml/
decks/*/lo-log.txt
findings.jsonl

# Per-attempt verification artifacts from verify_fix.py.
issues/*/verify/

# Renders of third-party decks are never published: two of the sample decks are marked
# confidential and all of them are copyrighted works.
issues/*/evidence-*.png
issues/*/pr/
**/*.png
